<?xml version="1.0"?>
<robot name="teknofest_ika">

  <material name="sari"><color rgba="1.0 0.76 0.03 1"/></material>
  <material name="siyah"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
    <!--
      Z=0.28: tekerlek yarıçapı (0.18) + zemin boşluğu (0.10)
      Böylece tekerlekler tam yere oturur.
    -->
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://teknofest_ika/meshes/govde.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.5 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="70.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="20.0" iyz="0" izz="30.0"/>
    </inertial>
  </link>

  <!-- ═══════════════════════════════════════════════
       SAĞ ÖN TEKERLEK
       X: +0.50  (öne doğru)
       Y: -0.335 (sağa doğru, negatif)
       Z: -0.10  (gövdenin altına iner, base_joint Z=0.28 ile birlikte net 0.18 → yere değer)
       Görsel: rpy="0 0 1.5708"  → STL sağ taraf için 90° döndürülmüş
  ════════════════════════════════════════════════ -->
  <link name="sag_on_teker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://teknofest_ika/meshes/tekerlek.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0563" ixy="0" ixz="0" iyy="0.0563" iyz="0" izz="0.1013"/>
    </inertial>
  </link>
  <joint name="sag_on_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sag_on_teker"/>
    <origin xyz="0.50 -0.335 -0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       SOL ÖN TEKERLEK
       X: +0.50  (sağ ön ile aynı — simetrik)
       Y: +0.335 (sola doğru, pozitif)
       Görsel: rpy="0 0 -1.5708" → sol taraf için ters döndürülmüş
  ════════════════════════════════════════════════ -->
  <link name="sol_on_teker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="package://teknofest_ika/meshes/tekerlek.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0563" ixy="0" ixz="0" iyy="0.0563" iyz="0" izz="0.1013"/>
    </inertial>
  </link>
  <joint name="sol_on_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sol_on_teker"/>
    <origin xyz="0.50 0.335 -0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       SOL ARKA TEKERLEK
       X: -0.60  (arkaya doğru)
       Y: +0.335 (sol taraf — ön ile aynı genişlik)
  ════════════════════════════════════════════════ -->
  <link name="sol_arka_teker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="package://teknofest_ika/meshes/tekerlek.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0563" ixy="0" ixz="0" iyy="0.0563" iyz="0" izz="0.1013"/>
    </inertial>
  </link>
  <joint name="sol_arka_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sol_arka_teker"/>
    <origin xyz="-0.60 0.335 -0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       SAĞ ARKA TEKERLEK
       X: -0.60  (sol arka ile aynı — simetrik)
       Y: -0.335 (sağ taraf)
  ════════════════════════════════════════════════ -->
  <link name="sag_arka_teker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="package://teknofest_ika/meshes/tekerlek.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0563" ixy="0" ixz="0" iyy="0.0563" iyz="0" izz="0.1013"/>
    </inertial>
  </link>
  <joint name="sag_arka_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sag_arka_teker"/>
    <origin xyz="-0.60 -0.335 -0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       DIFF DRIVE PLUGIN
       wheel_separation = 0.335 * 2 = 0.670
       wheel_diameter   = 0.18  * 2 = 0.360
  ════════════════════════════════════════════════ -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><namespace>/</namespace></ros>
      <update_rate>50</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>sol_on_joint</left_joint>
      <right_joint>sag_on_joint</right_joint>
      <left_joint>sol_arka_joint</left_joint>
      <right_joint>sag_arka_joint</right_joint>
      <wheel_separation>0.670</wheel_separation>
      <wheel_diameter>0.360</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>
<!-- ═══════════════════════════════════════════════
       KAMERA LİNKİ — base_link'e bağlı, aracın önünde
  ════════════════════════════════════════════════ -->
  <link name="kamera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="sari"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="kamera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="kamera_link"/>
    <origin xyz="0.55 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       LİDAR LİNKİ — aracın üstünde
  ════════════════════════════════════════════════ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.05"/></geometry>
      <material name="siyah"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0 0.30" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       IMU LİNKİ — gövdenin merkezinde
  ════════════════════════════════════════════════ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       OS30A 3D LiDAR — aracın önünde
       Montaj pozisyonu PLACEHOLDER — araçtan ölçülecek
  ════════════════════════════════════════════════ -->
  <link name="os30a_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.04"/></geometry>
      <material name="siyah"/>
    </visual>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="os30a_joint" type="fixed">
    <parent link="base_link"/>
    <child link="os30a_link"/>
    <!-- PLACEHOLDER: x=araç öne mesafesi, z=yerden yükseklik -->
    <origin xyz="0.30 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       KAMERA PLUGIN → /camera/image_raw
  ════════════════════════════════════════════════ -->
  <gazebo reference="kamera_link">
    <sensor type="camera" name="ileri_kamera">
      <update_rate>30</update_rate>
      <camera name="ileri_kamera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.02</near><far>100</far></clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=/camera/image_raw</remapping>
          <remapping>~/camera_info:=/camera/camera_info</remapping>
        </ros>
        <camera_name>ileri_kamera</camera_name>
        <frame_name>kamera_link</frame_name>
        <hack_baseline>0.0</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════════════════
       LİDAR PLUGIN → /scan
  ════════════════════════════════════════════════ -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ═══════════════════════════════════════════════
       IMU PLUGIN → /imu/data
  ════════════════════════════════════════════════ -->
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <update_rate>100</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>
</robot>
