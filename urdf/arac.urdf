<?xml version="1.0"?>
<!--
  NOT (kapsam/sınırlama):
  Bu URDF, robot_state_publisher + RViz2 görselleştirme/TF amaçlıdır.
  Gazebo simülasyon plugin'leri (diff_drive, kamera/lidar/imu sensörleri)
  KASITLI OLARAK KALDIRILDI — proje artık Gazebo simülasyonu kullanmıyor
  (bkz. git log: "simulasyon dosyalari kaldirildi").

  ÖNEMLİ: Tekerlek geometrisi (4× continuous joint, diferansiyel iz/wheelbase)
  DİFERANSİYEL SÜRÜŞLÜ TEST ARACINI yansıtır — gerçek yarışma aracının
  Ackermann (otomobil tipi direksiyon) kinematiğini TEMSİL ETMEZ. Gerçek
  araç için ayrı bir Ackermann URDF'i (ön direksiyon mafsallı tekerlekler)
  henüz oluşturulmadı; wheelbase/track ölçüleri config/*.yaml ve
  ackermann_converter.py parametreleriyle çapraz kontrol edilmeden
  gerçek araç tasarımı için referans alınmamalıdır.
-->
<robot name="teknofest_ika">

  <material name="sari"><color rgba="1.0 0.76 0.03 1"/></material>
  <material name="siyah"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="blue"><color rgba="0.0 0.0 0.8 1"/></material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
    <!--
      Z=0.28: tekerlek yarıçapı (0.18) + zemin boşluğu (0.10)
      Böylece tekerlekler tam yere oturur.
    -->
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.5 0.3"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.5 0.3"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="70.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="20.0" iyz="0" izz="30.0"/>
    </inertial>
  </link>

  <!-- ═══════════════════════════════════════════════
       SAĞ ÖN TEKERLEK
       X: +0.70 (öne doğru) — wheelbase=1.40m (2026-07-27 araçtan
                  ölçüldü), config/ekf.yaml, nav2_params.yaml
                  (minimum_turning_radius) ve ackermann_converter.py'deki
                  wheelbase parametresiyle TUTARLI tutulur; biri
                  değişirse diğerleri de değişmeli.
       Y: -0.335 (sağa doğru, negatif)
       Z: -0.10  (gövdenin altına iner, base_joint Z=0.28 ile birlikte net 0.18 → yere değer)
       Görsel: rpy="1.5708 0 0" → silindirin ekseni Y'ye yatırılır (dönme ekseni)
  ════════════════════════════════════════════════ -->
  <link name="sag_on_teker">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0563" ixy="0" ixz="0" iyy="0.0563" iyz="0" izz="0.1013"/>
    </inertial>
  </link>
  <joint name="sag_on_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sag_on_teker"/>
    <origin xyz="0.70 -0.335 -0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       SOL ÖN TEKERLEK
       X: +0.70 (sağ ön ile aynı — simetrik, wheelbase=1.40m)
       Y: +0.335 (sola doğru, pozitif)
       Görsel: sağ ön ile aynı — silindir simetrik olduğu için taraf ayrımı yok
  ════════════════════════════════════════════════ -->
  <link name="sol_on_teker">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0563" ixy="0" ixz="0" iyy="0.0563" iyz="0" izz="0.1013"/>
    </inertial>
  </link>
  <joint name="sol_on_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sol_on_teker"/>
    <origin xyz="0.70 0.335 -0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       SOL ARKA TEKERLEK
       X: -0.70 (arkaya doğru, wheelbase=1.40m — bkz. ön teker notu)
       Y: +0.335 (sol taraf — ön ile aynı genişlik)
  ════════════════════════════════════════════════ -->
  <link name="sol_arka_teker">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0563" ixy="0" ixz="0" iyy="0.0563" iyz="0" izz="0.1013"/>
    </inertial>
  </link>
  <joint name="sol_arka_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sol_arka_teker"/>
    <origin xyz="-0.70 0.335 -0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       SAĞ ARKA TEKERLEK
       X: -0.70 (sol arka ile aynı — simetrik)
       Y: -0.335 (sağ taraf)
  ════════════════════════════════════════════════ -->
  <link name="sag_arka_teker">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
      <material name="siyah"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="7.5"/>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <inertia ixx="0.0563" ixy="0" ixz="0" iyy="0.0563" iyz="0" izz="0.1013"/>
    </inertial>
  </link>
  <joint name="sag_arka_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sag_arka_teker"/>
    <origin xyz="-0.70 -0.335 -0.10" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <dynamics damping="0.5" friction="0.5"/>
  </joint>

<!-- ═══════════════════════════════════════════════
       KAMERA LİNKİ — base_link'e bağlı, aracın önünde
  ════════════════════════════════════════════════ -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="sari"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="kamera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.55 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       LİDAR LİNKİ — aracın üstünde
  ════════════════════════════════════════════════ -->
  <!-- Link adı sürücünün yayınladığı frame_id ile birebir aynı olmalı:
       lydia_ortam/tmini_pro.yaml → frame_id: laser_frame. Farklı isimde
       tanımlanırsa /scan hiçbir TF'e oturmaz ve costmap boş kalır. -->
  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.05"/></geometry>
      <material name="siyah"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <!-- Yaw 1.6284 rad = 93.3°: LiDAR gövdeye dönük monte edilmiş, açı sahada
       huniyle çift yönlü kalibre edildi. huni_reaktif aynı düzeltmeyi ham
       /scan üzerinde aci_offset_deg ile yapar; Nav2 costmap ise yalnız bu
       dönüşümü görür. Yükseklik zeminden tarama düzlemine ölçüldü (0.55 m).
       NOT: bu dönüşümü şu an boot betiğindeki statik yayıncı basıyor. Bir gün
       robot_state_publisher yığına eklenirse ikisi aynı TF'i yayınlar —
       o zaman statik laser yayıncısı kaldırılmalı. -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.0 0 0.55" rpy="0 0 1.6284"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       IMU LİNKİ — gövdenin merkezinde
  ════════════════════════════════════════════════ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════
       OS30A 3D LiDAR — aracın önünde
       Montaj pozisyonu PLACEHOLDER — araçtan ölçülecek
  ════════════════════════════════════════════════ -->
  <link name="os30a_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.04"/></geometry>
      <material name="siyah"/>
    </visual>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="os30a_joint" type="fixed">
    <parent link="base_link"/>
    <child link="os30a_link"/>
    <!-- PLACEHOLDER: x=araç öne mesafesi, z=yerden yükseklik -->
    <origin xyz="0.30 0 0.20" rpy="0 0 0"/>
  </joint>

</robot>
